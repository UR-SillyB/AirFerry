# Rust / Cargo
target/
**/*.rs.bk
*.pdb

# WebAssembly build artifacts
pkg/
*.wasm

# Node / pnpm
node_modules/
build/
.pnpm-store/
*.log

# Build output / release artifacts (published as GitHub Release assets,
# never checked into git). See docs/build-web-targets.md.
dist/
# Standalone single-file web build output (apps/web/dist-standalone/).
dist-standalone/
# Web receiver build output (apps/web/dist-receiver/ — separate zip from sender).
dist-receiver/

# Browser extension build output
apps/web/build/
# Single-track wasm-pack output (self-ignores via a generated .gitignore;
# listed here for clarity).
apps/web/wasm-pkg/
# Legacy dual-track wasm-pack outputs (removed in the single-track migration;
# guard against regression).
core/transfer-engine/pkg-*/

# Playwright MCP local session artifacts
.playwright-mcp/

# Android / Gradle
apps/scanner/.gradle/
apps/scanner/build/
apps/scanner/app/build/
apps/scanner/local.properties
apps/scanner/keystore.properties
apps/scanner/app/src/main/jniLibs/
apps/scanner/app/.cxx/
apps/scanner/captures/
*.apk
*.aab
*.keystore
!debug.keystore

# Windows / .NET (Rust C ABI DLL copied here by build-windows.ps1; C# build
# artifacts. transfer_engine.dll is a release artifact, never checked in.)
apps/windows/**/bin/
apps/windows/**/obj/
apps/windows/AirFerry.Windows/runtime/*.dll

# M3 fast decoder (ZXing-C++ → WASM) build artifacts. Generated by
# scripts/build-fastzxing.sh (emcmake build dir + linked .js/.wasm, and the copy
# bundled into the web/ext build). Never checked in — run build-fastzxing.sh first.
core/zxing-decoder/build-wasm/
core/zxing-decoder/airferry_zxing.js
core/zxing-decoder/airferry_zxing.wasm
apps/web/src/fastzxing/
# prepare-wasm.cjs copies the fastzxing artifacts into web's public/ for the
# receiver build (runtime fetch); never checked in (generated by build-fastzxing.sh).
apps/web/public/airferry_zxing.js
apps/windows/native/build/
apps/windows/.vs/

# IDE
.idea/
.vscode/
*.iml
*.swp

# OS
Thumbs.db
.DS_Store

# Published release artifacts (built via ./scripts/build-all.sh release;
# distributed through GitHub Releases, never checked into git).
release/

# CRX signing private key (do not commit)
*.pem

# Local agent working directories (session memory, scratch)
.workbuddy/
.zcode/
.codebuddy/

# Local HTTPS self-signed certs (contain private keys; used by serve-https.mjs
# for LAN receiver testing — never commit)
apps/web/.cert/
