{
  "name": "@airferry/web",
  "version": "1.2.7",
  "description": "AirFerry web & browser extension frontend — streams QR codes.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare-wasm": "node scripts/prepare-wasm.cjs",
    "predev": "node scripts/prepare-wasm.cjs",
    "predev:receiver": "node scripts/prepare-wasm.cjs",
    "prebuild": "node scripts/prepare-wasm.cjs",
    "prebuild:receiver": "node scripts/prepare-wasm.cjs",
    "prebuild:standalone": "node scripts/prepare-wasm.cjs",
    "prebuild:ext": "node scripts/prepare-wasm.cjs",
    "dev": "vite",
    "dev:receiver": "vite --config vite.receiver.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "wasm": "node scripts/build-wasm.cjs",
    "build": "vite build",
    "build:receiver": "vite build --config vite.receiver.config.ts",
    "build:standalone": "vite build --config vite.standalone.config.ts && node scripts/build-standalone.cjs",
    "build:ext": "node scripts/build-ext.cjs",
    "build:chrome-mv3": "node scripts/build-ext.cjs chrome-mv3",
    "build:chrome-mv2": "node scripts/build-ext.cjs chrome-mv2",
    "build:firefox-mv3": "node scripts/build-ext.cjs firefox-mv3",
    "build:firefox-mv2": "node scripts/build-ext.cjs firefox-mv2",
    "build:all": "npm run build && npm run build:receiver && npm run build:standalone && npm run build:ext",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
