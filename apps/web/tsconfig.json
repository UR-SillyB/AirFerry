{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext",
      "WebWorker"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "chrome",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@airferry-wasm/*": [
        "./wasm-pkg/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite.receiver.config.ts",
    "vite.standalone.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-receiver",
    "dist-standalone",
    "build"
  ]
}
