<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <!-- Version mirrors apps/web/package.json, apps/scanner build.gradle.kts,
         and Cargo.toml workspace version — keep all four in sync. -->
    <Version>1.2.7</Version>
    <AssemblyName>AirFerry</AssemblyName>
    <RootNamespace>AirFerry.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe/taskbar/Alt-Tab receiver icon (multi-size 16–128; source PNGs live
         in apps/web/assets/receiver-icon*.png). Note: ApplicationIcon sets the
         Win32 exe icon; XAML use via pack:// URI requires the explicit
         <Resource Include="Assets\app.ico" /> below. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed app.ico as a WPF Resource so pack://application:,,,/Assets/app.ico resolves at XAML runtime.
         ApplicationIcon only sets the Win32 exe header icon via /win32icon; the WPF SDK does NOT automatically
         promote ApplicationIcon into the assembly's g.resources stream. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Camera + capture-card capture via OpenCV's DirectShow/Media Foundation
         backends. OpenCvSharp4.runtime.win brings the native OpenCV DLLs. -->
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.windows" Version="4.9.0.20240103" />
    <!-- DirectShow video-input device enumeration (webcams + USB/HDMI capture
         cards are the same FilterCategory.VideoInputDevice). -->
    <PackageReference Include="DirectShowLib.Standard" Version="1.0.0" />
    <!-- MVVM source generators (ObservableObject, RelayCommand). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- HandyControl themed controls: skin dictionaries (light/dark swapped at
         runtime), hc:Window chrome with caption buttons, hc:Card, themed
         MessageBox. The AirFerry brand palette is layered on top in
         Themes/AirFerry.xaml (accent #2563EB + WPF-UI-era brush key aliases).
         No icon font ships with the library — glyphs use the system Segoe MDL2
         Assets font via the GlyphIcon style. Win10-compatible (no Mica). -->
    <PackageReference Include="HandyControl" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native prerequisites: Rust transfer engine and the shared ZXing-C++
         decoder. scripts/build-windows.ps1 (or build-all.sh windows) places
         both in runtime/. Loading is deferred to their managed bridges so a
         missing DLL produces a user-facing startup error. -->
    <!-- Generated DLLs are excluded from the SDK's default None glob. Add
         them explicitly and flatten them next to AirFerry.exe. -->
    <None Remove="runtime\transfer_engine.dll" />
    <None Remove="runtime\airferry_zxing.dll" />
    <Content Include="runtime\transfer_engine.dll" Condition="Exists('runtime\transfer_engine.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <TargetPath>transfer_engine.dll</TargetPath>
    </Content>
    <Content Include="runtime\airferry_zxing.dll" Condition="Exists('runtime\airferry_zxing.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <TargetPath>airferry_zxing.dll</TargetPath>
    </Content>
  </ItemGroup>

</Project>
