<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">
    <!-- AirFerry brand layer on top of HandyControl. Merged AFTER the HC skin
         and Theme.xaml, so every key here wins over the library default.
         Colors that must vary per theme stay in DesignTokens.{Light,Dark}.xaml;
         everything here is theme-constant or binds dynamically to the active
         HC skin. -->

    <!-- Brand accent (#2563EB, shared with the Android and web hosts). HC's
         PrimaryBrush/TitleBrush are gradients built on these colors; overriding
         the Color resources re-tints every style that binds them
         (ButtonPrimary, CheckBox, Slider, ComboBox/ListBox selection, ...). -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="DarkPrimaryColor">#1D4ED8</Color>
    <Color x:Key="TitleColor">#2563EB</Color>
    <Color x:Key="SecondaryTitleColor">#1D4ED8</Color>

    <!-- Flat solid brand brushes replace HC's horizontal gradients. -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{DynamicResource DarkPrimaryColor}" />

    <!-- Aliases keeping the WPF-UI-era token names used across all views.
         DynamicResource Color bindings re-resolve when ThemeService swaps the
         HC skin dictionary, so one alias set serves both themes.
         Third-level text is "ThirdlyTextColor" in HC (not "Tertiary").
         The page background maps to SecondaryRegionColor: HC leaves
         BackgroundColor at #eeeeee even in the dark skin; SecondaryRegionColor
         is the one that actually goes dark (#eeeeee -> #2d2d30). -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{DynamicResource ThirdlyTextColor}" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{DynamicResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource PrimaryColor}" />

    <!-- Icon stand-in for ui:SymbolIcon: glyph text in the system Segoe MDL2
         Assets font (guaranteed on Win10/11 — Segoe Fluent Icons is Win11-only
         and not redistributable). Foreground inherits from the parent (e.g.
         Button), so primary-button glyphs stay white automatically. -->
    <Style x:Key="GlyphIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Ghost button (replaces ui:Button Appearance="Transparent"): chromeless
         until hover, when ButtonDefault's trigger paints SecondaryRegionBrush. -->
    <Style x:Key="GhostButton" BasedOn="{StaticResource ButtonDefault}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Rounder cards to match the Fluent-era 8px radius (HC default is 4). -->
    <Style BasedOn="{StaticResource CardBaseStyle}" TargetType="hc:Card">
        <Setter Property="hc:BorderElement.CornerRadius" Value="8" />
    </Style>
</ResourceDictionary>
