<Page x:Class="AirFerry.Windows.Views.FileListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Title="AirFerry - 接收历史"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: back + title + clear-all. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE72B;" />
                    <TextBlock Text="返回" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1"
                       Text="接收历史"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Foreground="{DynamicResource ErrorBrush}"
                    Click="ClearAll_Click" x:Name="ClearButton">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE74D;" />
                    <TextBlock Text="清空" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <hc:Card Grid.Row="1">
            <ListView x:Name="FilesListView"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      MouseDoubleClick="FileList_DoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="340"
                                        DisplayMemberBinding="{Binding DisplayName}" />
                        <GridViewColumn Header="大小" Width="100"
                                        DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="修改时间" Width="160"
                                        DisplayMemberBinding="{Binding ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </hc:Card>

        <!-- Pending transfers card -->
        <hc:Card Grid.Row="2" x:Name="PendingCard" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="PendingTitle" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock x:Name="PendingDesc" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Click="ClearPending_Click" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center">
                    <TextBlock Text="清理断点" />
                </Button>
            </Grid>
        </hc:Card>

        <TextBlock Grid.Row="3"
                   x:Name="PathHint"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   FontSize="12"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Page>
