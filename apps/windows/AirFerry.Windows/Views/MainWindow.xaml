<hc:Window x:Class="AirFerry.Windows.Views.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="AirFerry"
           Width="780" Height="760"
           MinWidth="680" MinHeight="640"
           WindowStartupLocation="CenterScreen"
           NonClientAreaHeight="36"
           Icon="pack://application:,,,/Assets/app.ico">
    <!-- hc:Window supplies the chrome: icon + title in the non-client area
         (ShowIcon/ShowTitle default true) and min/max/close caption buttons
         from its WindowWin10 template. Do NOT set WindowStyle=None or
         AllowsTransparency — WindowChrome is applied internally. Below the
         title bar, the Frame hosts the page flow — Pages navigate via
         Page.NavigationService, which resolves to this Frame. The journal
         chrome stays hidden; every page draws its own back button. -->
    <Frame x:Name="RootFrame"
           Source="DeviceSelectView.xaml"
           NavigationUIVisibility="Hidden"
           JournalOwnership="OwnsJournal" />
</hc:Window>
