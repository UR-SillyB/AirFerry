<Page x:Class="AirFerry.Windows.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Title="AirFerry - 设置"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: back + title. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE72B;" />
                    <TextBlock Text="返回" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1"
                       Text="设置"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Appearance. HandyControl styles the standard ComboBox implicitly. -->
        <hc:Card Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="外观"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="浅色、深色，或跟随 Windows 系统主题"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          x:Name="ThemeComboBox"
                          MinWidth="140"
                          VerticalAlignment="Center"
                          SelectionChanged="Theme_SelectionChanged">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                </ComboBox>
            </Grid>
        </hc:Card>

        <!-- Default redundancy. -->
        <hc:Card Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Margin="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="默认冗余率"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="扫码中断后恢复所需的额外帧比例"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               x:Name="RedundancyText"
                               Text="5%"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
                <Slider x:Name="RedundancySlider"
                        Minimum="5" Maximum="50"
                        TickFrequency="5" TickPlacement="BottomRight"
                        IsSnapToTickEnabled="True"
                        Value="5"
                        Margin="0,8,0,0"
                        ValueChanged="Redundancy_Changed" />
            </StackPanel>
        </hc:Card>

        <!-- About. -->
        <hc:Card Grid.Row="3">
            <StackPanel Margin="20">
                <TextBlock Text="关于 AirFerry"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="完全离线的光学文件传输 · 摄像头扫码即收"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="VersionText"
                           Text="版本 1.0.0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,8,0,0" />
            </StackPanel>
        </hc:Card>
    </Grid>
</Page>
