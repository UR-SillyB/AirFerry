<Page x:Class="AirFerry.Windows.Views.ScanView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Title="AirFerry - 扫码接收"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: back + title + history. GhostButton replaces
             ui:Button Appearance="Transparent"; glyphs are Segoe MDL2 Assets
             text (see Themes/AirFerry.xaml GlyphIcon). -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource GhostButton}"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE72B;" />
                    <TextBlock Text="返回" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1"
                       Text="扫码接收"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Style="{StaticResource GhostButton}"
                    Click="FileList_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE838;" />
                    <TextBlock Text="文件" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Camera preview + progress ring. -->
        <Grid Grid.Row="1">
            <Border Background="{DynamicResource PreviewBackdropBrush}"
                    CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <!-- Live camera preview (updated via WriteableBitmap in code-behind). -->
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <!-- Circular progress ring overlaid in the center. -->
                    <Canvas x:Name="ProgressCanvas"
                            Width="180" Height="180"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Continuous receive: chosen on the device-select page before
             scanning; this card shows the folder and the live feed. -->
        <hc:Card Grid.Row="2"
                 x:Name="ContinuousCard"
                 Margin="0,12,0,0"
                 Visibility="Collapsed">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="ContinuousDirText"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="ContinuousChangeButton"
                            Click="ContinuousChange_Click"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8B7;" />
                            <TextBlock Text="更改" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            x:Name="ContinuousOpenButton"
                            Click="ContinuousOpen_Click"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE838;" />
                            <TextBlock Text="打开文件夹" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1"
                           x:Name="ContinuousSummaryText"
                           Text=""
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,6,0,0"
                           Visibility="Collapsed" />
                <ScrollViewer Grid.Row="2"
                              x:Name="ContinuousListScroll"
                              MaxHeight="110"
                              Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="ContinuousList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </hc:Card>

        <!-- Status card at the bottom. -->
        <hc:Card Grid.Row="3" Margin="0,12,0,0">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="StatusText"
                               Text="正在扫描…"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="FileSummaryText"
                               Text="等待描述符…"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="ProgressText"
                               Text="0 / 0"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="TransferMetricsText"
                               Text="解码 0 符号/秒 · 有效 0 B/s · 用时 00:00"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="ScanMetricsText"
                               Text="采集 0 帧 · 丢弃 0 帧 · 解码 0 码"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="RecoveryStageText"
                               Text=""
                               FontSize="13"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               Margin="0,4,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
                <!-- Stop/retry: glyph + text are named so SetStopButton can swap
                     them (stop E71A / retry E72C / continue E768). -->
                <Button Grid.Column="1"
                        x:Name="StopButton"
                        Click="Stop_Click"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StopButtonIcon"
                                   Style="{StaticResource GlyphIcon}" Text="&#xE71A;" />
                        <TextBlock x:Name="StopButtonText"
                                   Text="停止" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </hc:Card>
    </Grid>
</Page>
