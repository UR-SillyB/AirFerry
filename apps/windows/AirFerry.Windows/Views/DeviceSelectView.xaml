<Page x:Class="AirFerry.Windows.Views.DeviceSelectView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:ctrl="clr-namespace:AirFerry.Windows.Controls"
      Title="AirFerry - 选择扫描来源"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: app identity + settings. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="AirFerry"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="光学文件传输 · 选择扫描来源"
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource GhostButton}"
                    Click="Files_Click"
                    VerticalAlignment="Top"
                    Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE838;" />
                    <TextBlock Text="接收文件" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Style="{StaticResource GhostButton}"
                    Click="Settings_Click"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE713;" />
                    <TextBlock Text="设置" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Resume banner (visible only when continuing a segmented task). -->
        <ctrl:InfoBanner Grid.Row="1"
                         x:Name="ResumeBar"
                         Severity="Informational"
                         Title="继续恢复任务"
                         Visibility="Collapsed"
                         Margin="0,12,0,0" />

        <!-- Mutually-exclusive source list: cameras, capture cards, and screen capture. -->
        <hc:Card Grid.Row="2" Margin="0,16,0,0" VerticalAlignment="Stretch">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="扫描来源"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Name="SelectedInfo"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
                <ctrl:InfoBanner Grid.Row="1"
                                 x:Name="EmptyStateBar"
                                 Severity="Informational"
                                 Title="未检测到摄像头或采集卡"
                                 Message="仍可选择下方的屏幕捕获，或连接设备后点击刷新"
                                 Visibility="Collapsed"
                                 Margin="0,12,0,0" />
                <ListBox Grid.Row="2"
                         x:Name="DeviceList"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="15"
                         Margin="-8,8,-8,-8"
                         SelectionMode="Single"
                         SelectionChanged="DeviceList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DeviceIcon"
                                           Style="{StaticResource GlyphIcon}"
                                           Text="&#xE722;"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding FriendlyName}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCaptureCard}" Value="True">
                                    <Setter TargetName="DeviceIcon" Property="Text" Value="&#xE714;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsScreenCapture}" Value="True">
                                    <Setter TargetName="DeviceIcon" Property="Text" Value="&#xE7F4;" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </hc:Card>

        <!-- Continuous receive: chosen BEFORE scanning; files are saved into
             the chosen folder and the scan never stops between transfers. -->
        <hc:Card Grid.Row="3" Margin="0,16,0,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              x:Name="ContinuousToggle"
                              Content="持续接收"
                              Checked="ContinuousToggle_Checked"
                              Unchecked="ContinuousToggle_Unchecked"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="ContinuousDirText"
                               Text=""
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <Button Grid.Column="2"
                            x:Name="ContinuousPickButton"
                            Click="ContinuousPick_Click"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE838;" />
                            <TextBlock Text="选择文件夹" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1"
                           Text="接收完成后不停止扫描，文件自动保存到所选文件夹；重复文件自动跳过（按内容判定）"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,6,0,0" />
            </Grid>
        </hc:Card>

        <!-- Refresh only changes hardware enumeration; screen capture remains a list source. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE72C;" />
                    <TextBlock Text="刷新设备列表" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Primary action. HC buttons have a fixed 28px default height, so the
             taller primary CTA sets Height explicitly. -->
        <Button Grid.Row="5"
                x:Name="StartButton"
                Style="{StaticResource ButtonPrimary}"
                Click="StartScan_Click"
                Margin="0,20,0,0"
                FontSize="15"
                Height="40"
                HorizontalAlignment="Stretch"
                IsEnabled="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE768;" />
                <TextBlock Text="开始扫码" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
